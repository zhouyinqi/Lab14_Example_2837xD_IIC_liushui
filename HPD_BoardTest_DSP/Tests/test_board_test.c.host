           0U);

    hardware = BoardProfile_GetHardwareDescriptor(
        BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
        BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01,
        BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardSci_ResolveScibPinConfiguration(hardware, &configuration) ==
           0U);
    assert(BoardSci_ResolveScibPinConfiguration(0, &configuration) == 0U);
    assert(BoardSci_ResolveScibPinConfiguration(hardware, 0) == 0U);
}

