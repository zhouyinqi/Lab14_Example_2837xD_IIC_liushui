}

static void TestAdcBasicEvaluation(void)
{
    static const BoardTest_U16 expectedSignals[BOARD_ADC_MAX_CHANNEL_COUNT] =
    {
        BOARD_ADC_SIGNAL_IU1,
        BOARD_ADC_SIGNAL_IV1,
        BOARD_ADC_SIGNAL_IW1,
        BOARD_ADC_SIGNAL_IU2,
        BOARD_ADC_SIGNAL_IV2,
        BOARD_ADC_SIGNAL_IW2,
        BOARD_ADC_SIGNAL_UDC1,
        BOARD_ADC_SIGNAL_UDC2,
        BOARD_ADC_SIGNAL_MOTOR_TEMPERATURE,
        BOARD_ADC_SIGNAL_FAULT_1,
        BOARD_ADC_SIGNAL_FAULT_2,
        BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_1,
        BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_2,
        BOARD_ADC_SIGNAL_UUV1,
        BOARD_ADC_SIGNAL_UVW1,
        BOARD_ADC_SIGNAL_UUV2,
        BOARD_ADC_SIGNAL_UVW2
    };
    static const BoardTest_U16 expectedModules[BOARD_ADC_MAX_CHANNEL_COUNT] =
    {
        BOARD_ADC_MODULE_D,
        BOARD_ADC_MODULE_C,
        BOARD_ADC_MODULE_B,
        BOARD_ADC_MODULE_A,
        BOARD_ADC_MODULE_B,
        BOARD_ADC_MODULE_C,
        BOARD_ADC_MODULE_A,
        BOARD_ADC_MODULE_D,
        BOARD_ADC_MODULE_A,
        BOARD_ADC_MODULE_D,
        BOARD_ADC_MODULE_D,
        BOARD_ADC_MODULE_A,
        BOARD_ADC_MODULE_A,
        BOARD_ADC_MODULE_D,
        BOARD_ADC_MODULE_C,
        BOARD_ADC_MODULE_B,
        BOARD_ADC_MODULE_A
    };
    static const BoardTest_U16 expectedChannels[BOARD_ADC_MAX_CHANNEL_COUNT] =
    {
        0U, 3U, 3U, 15U, 2U, 2U, 14U, 1U, 3U, 2U,
        3U, 4U, 5U, 4U, 4U, 0U, 0U
    };
    BoardAdc_ChannelConfig config;
    BoardTest_Record record;
    BoardTest_U16 index;
    BoardTest_U16 raw;
    float voltage;

    assert(BoardAdc_EvaluateBasicSample(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               2048U,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x001F0800UL);

    assert(BoardAdc_EvaluateBasicSample(
               (BoardTest_U16)(BOARD_ADC_BASIC_STATUS_REQUIRED_MASK &
                               ~BOARD_ADC_BASIC_CONVERSION_DONE),
               2048U,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_ADC_SAMPLE);

    assert(BoardAdc_VoltageToRaw(0.0F) == 0U);
    assert(BoardAdc_VoltageToRaw(BOARD_ADC_REFERENCE_VOLTAGE_V) ==
           BOARD_ADC_RAW_MAX);
    raw = BoardAdc_VoltageToRaw(1.65F);
    assert((raw == 2047U) || (raw == 2048U));

    voltage = BoardAdc_RawToVoltage(BOARD_ADC_RAW_MAX);
    assert(voltage > 3.29F);
    assert(voltage <= BOARD_ADC_REFERENCE_VOLTAGE_V);

    assert(BoardAdc_GetChannelCount(
               BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
               BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01) ==
           BOARD_ADC_MAX_CHANNEL_COUNT);
    for(index = 0U; index < BOARD_ADC_MAX_CHANNEL_COUNT; index++)
    {
        assert(BoardAdc_GetChannelConfig(
                   BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
                   BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01,
                   index,
                   &config) != 0U);
        assert(config.signalId == expectedSignals[index]);
        assert(config.module == expectedModules[index]);
        assert(config.channel == expectedChannels[index]);
    }
    assert(BoardAdc_GetChannelConfig(
               BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
               BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01,
               BOARD_ADC_MAX_CHANNEL_COUNT,
               &config) == 0U);

    assert(BoardAdc_EvaluateChannelScan(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               BOARD_ADC_MAX_CHANNEL_COUNT,
               BOARD_ADC_MAX_CHANNEL_COUNT,
               BOARD_ADC_NO_FAILED_CHANNEL,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x001FFFFFUL);
    assert(record.measuredValue == 17.0F);

    assert(BoardAdc_EvaluateChannelScan(
               (BoardTest_U16)(BOARD_ADC_BASIC_STATUS_REQUIRED_MASK &
                               ~BOARD_ADC_BASIC_CONVERSION_DONE),
               16U,
               BOARD_ADC_MAX_CHANNEL_COUNT,
               7U,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_ADC_SAMPLE);
    assert(record.rawValue == 0x00170007UL);

    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_IU1) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_IW2) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_UDC1) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_UDC2) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_1) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_2) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_UUV1) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_UVW1) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_UUV2) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_UVW2) != 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_MOTOR_TEMPERATURE) == 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_FAULT_1) == 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_FAULT_2) == 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_D5V) == 0U);
    assert(BoardAdc_IsExternalInjectionSignalSupported(
               BOARD_ADC_SIGNAL_A5V) == 0U);
    assert(BoardAdc_IsExternalInjectionSelectionSupported(
               BOARD_ADC_EXTERNAL_SELECTION_GROUP_1) != 0U);
    assert(BoardAdc_IsExternalInjectionSelectionSupported(
               BOARD_ADC_EXTERNAL_SELECTION_GROUP_2) != 0U);
    assert(BoardAdc_IsExternalInjectionSelectionSupported(0x0082U) == 0U);
    {
        static const BoardTest_U16 expectedGroup1[] =
        {
            BOARD_ADC_SIGNAL_IU1,
            BOARD_ADC_SIGNAL_IV1,
            BOARD_ADC_SIGNAL_IW1,
            BOARD_ADC_SIGNAL_UDC1,
            BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_1,
            BOARD_ADC_SIGNAL_UUV1,
            BOARD_ADC_SIGNAL_UVW1
        };
        static const BoardTest_U16 expectedGroup2[] =
        {
            BOARD_ADC_SIGNAL_IU2,
            BOARD_ADC_SIGNAL_IV2,
            BOARD_ADC_SIGNAL_IW2,
            BOARD_ADC_SIGNAL_UDC2,
            BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_2,
            BOARD_ADC_SIGNAL_UUV2,
            BOARD_ADC_SIGNAL_UVW2
        };
        BoardTest_U16 groupSignal;
        BoardTest_U16 groupIndex;

        for(groupIndex = 0U;
            groupIndex < BOARD_ADC_EXTERNAL_GROUP_CHANNEL_COUNT;
            groupIndex++)
        {
            assert(BoardAdc_GetExternalInjectionGroupSignal(
                       BOARD_ADC_EXTERNAL_SELECTION_GROUP_1,
                       groupIndex,
                       &groupSignal) != 0U);
            assert(groupSignal == expectedGroup1[groupIndex]);
            assert(BoardAdc_GetExternalInjectionGroupSignal(
                       BOARD_ADC_EXTERNAL_SELECTION_GROUP_2,
                       groupIndex,
                       &groupSignal) != 0U);
            assert(groupSignal == expectedGroup2[groupIndex]);
        }
        assert(BoardAdc_GetExternalInjectionGroupSignal(
                   BOARD_ADC_EXTERNAL_SELECTION_GROUP_1,
                   BOARD_ADC_EXTERNAL_GROUP_CHANNEL_COUNT,
                   &groupSignal) == 0U);
    }
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_SIGNAL_IV1, 1000U, 100U) != 0U);
    assert(gBoardAdcExternalInjectionConfig.configured != 0U);
    assert(gBoardAdcExternalInjectionConfig.signalId == BOARD_ADC_SIGNAL_IV1);
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_SIGNAL_UDC1, 1000U, 100U) != 0U);
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_SIGNAL_INVERTER_TEMPERATURE_1,
               1000U,
               100U) != 0U);
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_SIGNAL_D5V, 1000U, 100U) == 0U);
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_EXTERNAL_SELECTION_GROUP_1,
               1000U,
               100U) != 0U);
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_SIGNAL_IU1, 5001U, 100U) == 0U);
    assert(BoardAdc_ConfigureExternalInjection(
               BOARD_ADC_SIGNAL_IU1, 1000U, 0U) == 0U);

    assert(BoardAdc_EvaluateExternalInjection(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               2048U,
               2.5F,
               0.1F,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.measuredValue > 2.49F);
    assert(record.measuredValue < 2.51F);
    assert(BoardAdc_EvaluateExternalInjection(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               2048U,
               1.0F,
               0.1F,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_ADC_EXTERNAL_INJECTION);

    assert(BoardAdc_EvaluateExternalInjectionGroup(
               BOARD_ADC_EXTERNAL_SELECTION_GROUP_1,
               BOARD_ADC_EXTERNAL_GROUP_REQUIRED_MASK,
               0U,
               BOARD_ADC_EXTERNAL_GROUP_CHANNEL_COUNT,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x007F0000UL);
    assert(record.measuredValue == 7.0F);
    assert(BoardAdc_EvaluateExternalInjectionGroup(
               BOARD_ADC_EXTERNAL_SELECTION_GROUP_2,
               0x007BU,
               0x0004U,
               BOARD_ADC_EXTERNAL_GROUP_CHANNEL_COUNT,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_ADC_EXTERNAL_INJECTION);
    assert(record.rawValue == 0x007B0004UL);
    assert(record.measuredValue == 6.0F);

    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_PT100_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 3U) != 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_PT100_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE) == 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_PT100_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 1U) == 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_PT100_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 2U) == 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_PT100_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 4U) == 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_NTC_MUX_EXTERNAL,
               0x00A5U) == 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_FAULT_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_FAULT_GROUP_1_BASE + 5U) == 0U);
    assert(BoardAdc_IsMuxSelectionSupported(
               BOARD_TEST_ID_ADC_FAULT_MUX_EXTERNAL,
               BOARD_ADC_EXTERNAL_SELECTION_FAULT_GROUP_2_BASE + 5U) == 0U);
    assert(BoardAdc_GetMuxSelectorCode(
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 2U,
               &raw) != 0U);
    assert(raw == 2U);
    assert(BoardAdc_GetMuxSelectorCode(
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE,
               &raw) != 0U);
    assert(raw == 0U);
    assert(BoardAdc_GetMuxSelectorCode(
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 1U,
               &raw) != 0U);
    assert(raw == 1U);
    assert(BoardAdc_GetMuxSelectorCode(
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE + 3U,
               &raw) != 0U);
    assert(raw == 3U);
    assert(BoardAdc_GetMuxSelectorCode(
               BOARD_ADC_EXTERNAL_SELECTION_FAULT_GROUP_1_BASE + 4U,
               &raw) != 0U);
    assert(raw == 4U);
    assert(BoardAdc_GetMuxSelectorCode(
               BOARD_ADC_EXTERNAL_SELECTION_FAULT_GROUP_2_BASE + 2U,
               &raw) != 0U);
    assert(raw == 2U);
    assert(BoardAdc_GetMuxSelectorCode(0x00D0U, &raw) == 0U);
    voltage = BoardAdc_Pt100VoltageToResistance(0.0F);
    assert(voltage > 179.9F);
    assert(voltage < 180.1F);
    voltage = BoardAdc_Pt100VoltageToResistance(1.6877272F);
    assert(voltage > 119.9F);
    assert(voltage < 120.1F);
    raw = BoardAdc_VoltageToRaw(1.6877272F);
    assert(BoardAdc_EvaluatePt100Injection(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               raw,
               1.688F,
               0.100F,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.measuredValue > 1.687F);
    assert(record.measuredValue < 1.689F);
    assert(record.expectedMin > 1.587F);
    assert(record.expectedMax < 1.789F);
    assert(BoardAdc_EvaluatePt100Injection(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               raw,
               2.557F,
               0.100F,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_ADC_MUX_INJECTION);
    voltage = BoardAdc_FaultVoltageToDutyPercent(2.5F);
    assert(voltage > 49.9F);
    assert(voltage < 50.1F);
    assert(BoardAdc_EvaluateMuxInjection(
               BOARD_ADC_EXTERNAL_SELECTION_PT100_BASE,
               0x0001U,
               0U,
               1U,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(BoardAdc_EvaluateMuxInjection(
               BOARD_ADC_EXTERNAL_SELECTION_FAULT_GROUP_1_BASE,
               0x0001U,
               0x0000U,
               1U,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(BoardAdc_EvaluateMuxInjection(
               BOARD_ADC_EXTERNAL_SELECTION_FAULT_GROUP_2_BASE,
               0x0000U,
               0x0001U,
               1U,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_ADC_MUX_INJECTION);
    assert(BoardAdc_EvaluateExternalInjection(
               BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
               BOARD_ADC_RAW_MAX,
               5.0F,
               0.01F,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.measuredValue == 5.0F);
}

