static void TestDriverFaultDiEvaluation(void)
{
    BoardTest_Record record;

    assert(BoardDi_EvaluateDriverFaultStatus(
               BOARD_DI_DSP_REQUIRED_STATUS_MASK,
               BOARD_DI_FAIL_NONE,
               BOARD_DI_DRIVER_FAULT_DEFAULT_CHANNEL_MASK,
               BOARD_DI_DRIVER_FAULT_INPUT_MASK,
               BOARD_DI_DRIVER_FAULT_INPUT_MASK,
               BOARD_DI_DRIVER_FAULT_INPUT_MASK,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x000F000FUL);
    assert(record.measuredValue == 15.0F);

    assert(BoardDi_EvaluateDriverFaultStatus(
               BOARD_DI_STATUS_CONFIGURED |
               BOARD_DI_STATUS_INACTIVE_SEEN,
               BOARD_DI_FAIL_TIMEOUT,
               BOARD_DI_DRIVER_FAULT_DEFAULT_CHANNEL_MASK,
               BOARD_DI_DRIVER_FAULT_INPUT_MASK,
               0x0007U,
               0x0007U,
               &record) == BOARD_TEST_RESULT_TIMEOUT);
    assert(record.errorCode ==
           BOARD_TEST_ERROR_DRIVER_FAULT_DI_EXTERNAL);
}

static void TestDriverFaultGroupCapture(void)
{
    BoardTest_Record record;

    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        BOARD_DI_DRIVER_FAULT_GROUP_1_MASK, 3U, 3U, 3U,
        &record) == BOARD_TEST_RESULT_PASS);
    assert(record.expectedMin == 3.0F);
    assert(record.expectedMax == 3.0F);
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        BOARD_DI_DRIVER_FAULT_GROUP_2_MASK, 12U, 12U, 12U,
        &record) == BOARD_TEST_RESULT_PASS);

    /* One good input does not hide a broken input in the selected group. */
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        BOARD_DI_DRIVER_FAULT_GROUP_1_MASK, 3U, 3U, 1U,
        &record) == BOARD_TEST_RESULT_FAIL);
    /* Signals from the unselected connector do not satisfy the selected group. */
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        BOARD_DI_DRIVER_FAULT_GROUP_2_MASK, 15U, 15U, 3U,
        &record) == BOARD_TEST_RESULT_FAIL);

    /* Ordinary three-channel DI remains an all-channel test. */
    assert(BoardDi_EvaluateDspStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        7U, 7U, 7U, 3U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_CONFIG,
        15U, 1U, 1U, 1U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardDi_EvaluateDriverFaultStatus(
        0U, BOARD_DI_FAIL_NONE,
        15U, 1U, 1U, 1U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        0U, 1U, 1U, 1U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        0x001FU, 1U, 1U, 1U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardDi_EvaluateDriverFaultStatus(
        BOARD_DI_DSP_REQUIRED_STATUS_MASK, BOARD_DI_FAIL_NONE,
        2U, 1U, 1U, 1U, &record) == BOARD_TEST_RESULT_FAIL);
}

static void TestProtectionFaultDiEvaluation(void)
{
    BoardTest_Record record;

    assert(BoardDi_EvaluateProtectionFaultStatus(
               BOARD_DI_DSP_REQUIRED_STATUS_MASK,
               BOARD_DI_FAIL_NONE,
               BOARD_DI_PROTECTION_FAULT_DEFAULT_CHANNEL_MASK,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x000F000FUL);
    assert(record.measuredValue == 15.0F);

    assert(BoardDi_EvaluateProtectionFaultStatus(
               BOARD_DI_STATUS_CONFIGURED |
               BOARD_DI_STATUS_INACTIVE_SEEN,
               BOARD_DI_FAIL_TIMEOUT,
               BOARD_DI_PROTECTION_FAULT_DEFAULT_CHANNEL_MASK,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               0x0007U,
               0x0007U,
               &record) == BOARD_TEST_RESULT_TIMEOUT);
    assert(record.errorCode ==
           BOARD_TEST_ERROR_PROTECTION_FAULT_DI_EXTERNAL);
}

static void TestProtectionThresholdEvaluation(void)
{
    BoardTest_Record record;

    assert(BoardAdc_EvaluateProtectionThreshold(
               BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK,
               BOARD_ADC_PROTECTION_FAIL_NONE,
               BOARD_ADC_PROTECTION_SELECTION_OC_HIGH_BASE,
               BOARD_DI_PROTECTION_OC1_BIT,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               4.9F,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x0BFF010FUL);
    assert(record.expectedMin == BOARD_ADC_PROTECTION_OC_HIGH_THRESHOLD_V);
    assert(record.expectedMax == BOARD_ADC_PROTECTION_TERMINAL_MAX_V);

    assert(BoardAdc_EvaluateProtectionThreshold(
               BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK,
               BOARD_ADC_PROTECTION_FAIL_NONE,
               BOARD_ADC_PROTECTION_SELECTION_OC_LOW_BASE,
               BOARD_DI_PROTECTION_OC1_BIT,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               0.1F,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.expectedMin == 0.0F);
    assert(record.expectedMax == BOARD_ADC_PROTECTION_OC_LOW_THRESHOLD_V);

    assert(BoardAdc_EvaluateProtectionThreshold(
               BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK,
               BOARD_ADC_PROTECTION_FAIL_NONE,
               BOARD_ADC_PROTECTION_SELECTION_UOV_BASE,
               BOARD_DI_PROTECTION_UOV1_BIT,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               4.0F,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.expectedMin == BOARD_ADC_PROTECTION_UOV_THRESHOLD_V);
    assert((record.rawValue >> 28U) ==
           BOARD_ADC_PROTECTION_SELECTION_UOV_BASE);

    assert(BoardAdc_EvaluateProtectionThreshold(
               (BoardTest_U16)(BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK &
                               ~BOARD_ADC_PROTECTION_STATUS_XINT_TRIGGERED),
               BOARD_ADC_PROTECTION_FAIL_TIMEOUT,
               BOARD_ADC_PROTECTION_SELECTION_UOV_BASE,
               BOARD_DI_PROTECTION_UOV1_BIT,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               4.0F,
               &record) == BOARD_TEST_RESULT_TIMEOUT);
    assert(record.errorCode ==
           BOARD_TEST_ERROR_PROTECTION_FAULT_DI_EXTERNAL);

    assert(BoardAdc_EvaluateProtectionThreshold(
               (BoardTest_U16)(BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK &
                               ~(BOARD_ADC_PROTECTION_STATUS_FAULT_ASSERTED |
                                 BOARD_ADC_PROTECTION_STATUS_BREAK_ASSERTED |
                                 BOARD_ADC_PROTECTION_STATUS_XINT_TRIGGERED)),
               BOARD_ADC_PROTECTION_FAIL_RESPONSE,
               BOARD_ADC_PROTECTION_SELECTION_OC_HIGH_BASE,
               0U,
               BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
               4.9F,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode ==
           BOARD_TEST_ERROR_PROTECTION_FAULT_DI_EXTERNAL);

    assert(BoardAdc_EvaluateProtectionThreshold(
               BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK,
               BOARD_ADC_PROTECTION_FAIL_NONE,
               BOARD_ADC_PROTECTION_SELECTION_COUNT,
               0U,
               0U,
               4.0F,
               &record) == BOARD_TEST_RESULT_FAIL);
}

