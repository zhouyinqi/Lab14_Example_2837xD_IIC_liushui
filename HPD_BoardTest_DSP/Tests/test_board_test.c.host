#include <assert.h>
#include <stdio.h>

#include "Board_Adc_Test.h"
#include "Board_Can_Test.h"
#include "Board_Dido_Test.h"
#include "Board_Di_Test.h"
#include "Board_Emif_Test.h"
#include "Board_Ethernet_Test.h"
#include "Board_W5500_Test.h"
#include "Board_Fpga_Test.h"
#include "Board_Gpio_Test.h"
#include "Board_Hdo_Test.h"
#include "Board_I2c_Test.h"
#include "Board_Sci_Test.h"
#include "Board_Spi_Test.h"
#include "Board_Pwm_Test.h"
#include "Board_System_Test.h"
#include "Board_Test.h"
#include "Board_Pinmap.h"
#include "Board_Profile.h"
#include "Hpd_Test_Limits.h"

static BoardTest_Result TestExecutor(BoardTest_U16 testId,
                                     BoardTest_Record *record)
{
    if(testId == BOARD_TEST_ID_SYS_STARTUP)
    {
        record->measuredValue = 1.0F;
        return BOARD_TEST_RESULT_PASS;
    }

    if(testId == BOARD_TEST_ID_I2C_RTC)
    {
        record->rawValue = 0UL;
        return BOARD_TEST_RESULT_PASS;
    }

    if(testId == BOARD_TEST_ID_I2C_B_TMP116)
    {
        return BoardI2c_EvaluateTmp116Read(BOARD_I2C_STATUS_SUCCESS,
                                           BOARD_I2C_TMP116_ADDR_MIN,
                                           BOARD_I2C_TMP116_DEVICE_ID,
                                           0x1900U,
                                           record);
    }

    if(testId == BOARD_TEST_ID_SCI_HOST)
    {
        return BoardSci_EvaluateLoopbackStatus(
            (BoardTest_U16)BOARD_SCI_LOOPBACK_EXPECTED_MASK,
            BOARD_SCI_LOOPBACK_SCIA_PATTERN,
            BOARD_SCI_LOOPBACK_SCIB_PATTERN,
            record);
    }

    if(testId == BOARD_TEST_ID_SCI_RS485_EXTERNAL)
    {
        return BoardSci_EvaluateRs485ExternalStatus(
            (BoardTest_U16)BOARD_SCI_RS485_EXTERNAL_REQUIRED_MASK,
            BOARD_SCI_RS485_EXTERNAL_REQUEST,
            BOARD_SCI_RS485_EXTERNAL_RESPONSE,
            record);
    }

    if(testId == BOARD_TEST_ID_RS422_EXTERNAL)
    {
        return BoardSci_EvaluateRs422ExternalStatus(
            (BoardTest_U16)BOARD_SCI_RS422_EXTERNAL_REQUIRED_MASK,
            BOARD_SCI_RS422_EXTERNAL_REQUEST,
            BOARD_SCI_RS422_EXTERNAL_RESPONSE,
            record);
    }

    if(testId == BOARD_TEST_ID_SCIA_HANDHELD_EXTERNAL)
    {
        return BoardSci_EvaluateSciaHandheldExternalStatus(
            (BoardTest_U16)BOARD_SCI_HANDHELD_EXTERNAL_DIAGNOSTIC_MASK,
            BOARD_SCI_HANDHELD_EXTERNAL_REQUEST,
            BOARD_SCI_HANDHELD_EXTERNAL_RESPONSE,
            record);
    }

    if(testId == BOARD_TEST_ID_CAN_HOST)
    {
        return BoardCan_EvaluateLoopbackStatus(
            (BoardTest_U16)BOARD_CAN_LOOPBACK_EXPECTED_MASK,
            BOARD_CAN_LOOPBACK_TX_PATTERN,
            BOARD_CAN_LOOPBACK_TX_PATTERN,
            0U,
            record);
    }

    if(testId == BOARD_TEST_ID_CAN_EXTERNAL)
    {
        return BoardCan_EvaluateExternalStatus(
            (BoardTest_U16)BOARD_CAN_EXTERNAL_EXPECTED_MASK,
            BOARD_CAN_EXTERNAL_REQUEST_ID,
            BOARD_CAN_EXTERNAL_DATA_BYTES,
            BOARD_CAN_EXTERNAL_REQUEST_PATTERN,
            BOARD_CAN_EXTERNAL_RESPONSE_ID,
            BOARD_CAN_EXTERNAL_REQUEST_PATTERN,
            0U,
            record);
    }

    if(testId == BOARD_TEST_ID_ADC_BASIC)
    {
        return BoardAdc_EvaluateBasicSample(
            BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
            2048U,
            record);
    }

    if(testId == BOARD_TEST_ID_ADC_EXTERNAL_INJECTION)
    {
        return BoardAdc_EvaluateExternalInjection(
            BOARD_ADC_BASIC_STATUS_REQUIRED_MASK,
            2048U,
            2.5F,
            0.1F,
            record);
    }

    if((testId == BOARD_TEST_ID_ADC_EXTERNAL_GROUP_1) ||
       (testId == BOARD_TEST_ID_ADC_EXTERNAL_GROUP_2))
    {
        return BoardAdc_EvaluateExternalInjectionGroup(
            (testId == BOARD_TEST_ID_ADC_EXTERNAL_GROUP_1) ?
                BOARD_ADC_EXTERNAL_SELECTION_GROUP_1 :
                BOARD_ADC_EXTERNAL_SELECTION_GROUP_2,
            BOARD_ADC_EXTERNAL_GROUP_REQUIRED_MASK,
            0U,
            BOARD_ADC_EXTERNAL_GROUP_CHANNEL_COUNT,
            record);
    }

    if(testId == BOARD_TEST_ID_PWM_BASIC)
    {
        return BoardPwm_EvaluateSafetyStatus(
            BOARD_PWM_SAFE_REQUIRED_MASK,
            BOARD_EPWM_PAIR_COUNT,
            0U,
            record);
    }

    if(testId == BOARD_TEST_ID_PWM_DIDO_EXTERNAL)
    {
        return BoardPwm_EvaluateDidoStatus(
            BOARD_PWM_DIDO_REQUIRED_MASK,
            BOARD_PWM_DIDO_FAIL_NONE,
            BOARD_PWM_DIDO_OUTPUT_MASK,
            BOARD_PWM_DIDO_OUTPUT_MASK,
            record);
    }

    if(testId == BOARD_TEST_ID_DRIVER_FAULT_DI_EXTERNAL)
    {
        return BoardDi_EvaluateDriverFaultStatus(
            BOARD_DI_DSP_REQUIRED_STATUS_MASK,
            BOARD_DI_FAIL_NONE,
            BOARD_DI_DRIVER_FAULT_DEFAULT_CHANNEL_MASK,
            BOARD_DI_DRIVER_FAULT_INPUT_MASK,
            BOARD_DI_DRIVER_FAULT_INPUT_MASK,
            BOARD_DI_DRIVER_FAULT_INPUT_MASK,
            record);
    }

    if(testId == BOARD_TEST_ID_PROTECTION_FAULT_DI_EXTERNAL)
    {
        return BoardAdc_EvaluateProtectionThreshold(
            BOARD_ADC_PROTECTION_REQUIRED_STATUS_MASK,
            BOARD_ADC_PROTECTION_FAIL_NONE,
            BOARD_ADC_PROTECTION_SELECTION_OC_HIGH_BASE,
            BOARD_DI_PROTECTION_OC1_BIT,
            BOARD_DI_PROTECTION_FAULT_INPUT_MASK,
            4.9F,
            record);
    }

    if(testId == BOARD_TEST_ID_DRIVER_RESET_DO_EXTERNAL)
    {
        return BoardDido_EvaluateDriverResetStatus(
            BOARD_DRIVER_RESET_REQUIRED_STATUS,
            BOARD_DIDO_FAIL_NONE,
            BOARD_DRIVER_RESET_CHANNEL_URST1,
            record);
    }

    if(testId == BOARD_TEST_ID_EMIF_BASIC)
    {
        return BoardEmif_EvaluateBasicStatus(
            BOARD_EMIF_BASIC_REQUIRED_MASK,
            BOARD_EMIF_ASYNC_REQUIRED_MASK,
            BOARD_EMIF_ASYNC_REQUIRED_MASK,
            record);
    }

    if(testId == BOARD_TEST_ID_EMIF_EXTERNAL)
    {
        return BoardEmif_EvaluateSramStatus(
            BOARD_EMIF_SRAM_REQUIRED_MASK,
            BOARD_EMIF_SRAM_FAIL_NONE,
            0xA5A5U,
            0xA5A5U,
            record);
    }

    if(testId == BOARD_TEST_ID_FPGA_EMIF2_BASIC)
    {
        return BoardFpga_EvaluateEmif2Status(
            BOARD_FPGA_EMIF2_REQUIRED_MASK,
            BOARD_FPGA_FAIL_NONE,
            BOARD_FPGA_TEST1_EXPECTED,
            BOARD_FPGA_TEST2_EXPECTED,
            BOARD_FPGA_TEST3_EXPECTED,
            record);
    }

    if(testId == BOARD_TEST_ID_DIDO_FPGA_DO_EXTERNAL)
    {
        return BoardDido_EvaluateFpgaDoStatus(
            BOARD_DIDO_STATUS_CONFIGURED |
            BOARD_DIDO_STATUS_MAGIC_VALID |
            BOARD_DIDO_STATUS_CHANNEL_1_TOGGLED |
            BOARD_DIDO_STATUS_CHANNEL_2_TOGGLED |
            BOARD_DIDO_STATUS_CHANNEL_3_TOGGLED |
            BOARD_DIDO_STATUS_OUTPUTS_DISABLED,
            BOARD_DIDO_FAIL_NONE,
            BOARD_DIDO_DEFAULT_CHANNEL_MASK,
            record);
    }

    if(testId == BOARD_TEST_ID_HDO_FPGA_EXTERNAL)
    {
        return BoardHdo_EvaluateFpgaStatus(
            BOARD_HDO_STATUS_CONFIGURED |
            BOARD_HDO_STATUS_MAGIC_VALID |
            BOARD_HDO_STATUS_CHANNEL_1_TOGGLED |
            BOARD_HDO_STATUS_CHANNEL_2_TOGGLED |
            BOARD_HDO_STATUS_OUTPUTS_DISABLED,
            BOARD_HDO_FAIL_NONE,
            BOARD_HDO_DEFAULT_CHANNEL_MASK,
            record);
    }

    if(testId == BOARD_TEST_ID_DI_FPGA_EXTERNAL)
    {
        return BoardDi_EvaluateFpgaStatus(
            BOARD_DI_REQUIRED_STATUS_MASK,
            BOARD_DI_FAIL_NONE,
            BOARD_DI_DEFAULT_CHANNEL_MASK,
            BOARD_DI_INPUT_MASK,
            BOARD_DI_INPUT_MASK,
            BOARD_DI_INPUT_MASK,
            record);
    }

    if(testId == BOARD_TEST_ID_ETHERNET)
    {
        return BoardEthernet_EvaluateW5300BasicStatus(
            BOARD_ETHERNET_W5300_REQUIRED_MASK,
            BOARD_ETHERNET_W5300_MODE_EXPECTED,
            BOARD_ETHERNET_W5300_RTR_EXPECTED,
            BOARD_ETHERNET_W5300_RCR_EXPECTED,
            BOARD_ETHERNET_W5300_MEM_EXPECTED,
            BOARD_ETHERNET_W5300_MEM_EXPECTED,
            0x0000U,
            record);
    }

    if(testId == BOARD_TEST_ID_ETHERNET_SOCKET)
    {
        return BoardEthernet_EvaluateW5300SocketStatus(
            BOARD_ETHERNET_SOCKET_REQUIRED_MASK,
            0x0021U,
            12001U,
            0x1300U,
            0x1400U,
            0x0000U,
            record);
    }

    if(testId == BOARD_TEST_ID_ETHERNET_TCP_LINK)
    {
        return BoardEthernet_EvaluateW5300TcpLinkStatus(
            BOARD_ETHERNET_TCP_LINK_REQUIRED_MASK,
            0x1400U,
            0x1701U,
            0x0000U,
            49152U,
            record);
    }

    if(testId == BOARD_TEST_ID_ETHERNET_TCP_ECHO)
    {
        return BoardEthernet_EvaluateW5300TcpEchoStatus(
            BOARD_ETHERNET_TCP_ECHO_REQUIRED_MASK,
            0x1710U,
            4U,
            8192U,
            record);
    }

    if(testId == BOARD_TEST_ID_ETHERNET_TCP_STABILITY)
    {
        return BoardEthernet_EvaluateW5300TcpStabilityStatus(
            BOARD_ETHERNET_TCP_STABILITY_REQUIRED_MASK,
            0x1710U,
            5U,
            5U,
            record);
    }

    if(testId == BOARD_TEST_ID_SPIA_INTERNAL)
    {
        return BoardSpi_EvaluateLoopbackStatus(
            BOARD_SPI_LOOPBACK_REQUIRED_MASK,
            BOARD_SPI_LOOPBACK_SPIA_PATTERN,
            BOARD_SPI_LOOPBACK_SPIA_PATTERN,
            record);
    }

    if(testId == BOARD_TEST_ID_SPIB_INTERNAL)
    {
        return BoardSpi_EvaluateLoopbackStatus(
            BOARD_SPI_LOOPBACK_REQUIRED_MASK,
            BOARD_SPI_LOOPBACK_SPIB_PATTERN,
            BOARD_SPI_LOOPBACK_SPIB_PATTERN,
            record);
    }

    if(testId == BOARD_TEST_ID_SPIC_INTERNAL)
    {
        return BoardSpi_EvaluateLoopbackStatus(
            BOARD_SPI_LOOPBACK_REQUIRED_MASK,
            BOARD_SPI_LOOPBACK_SPIC_PATTERN,
            BOARD_SPI_LOOPBACK_SPIC_PATTERN,
            record);
    }

    if(testId == BOARD_TEST_ID_SPI_EXTERNAL)
    {
        return BoardSpi_EvaluateExternalStatus(
            BOARD_SPI_EXTERNAL_REQUIRED_MASK,
            BOARD_SPI_EXTERNAL_FAIL_NONE,
            record);
    }

    if(testId == BOARD_TEST_ID_SPIB_FLASH_EXTERNAL)
    {
        return BoardSpi_EvaluateSpibFlashStatus(
            BOARD_SPIB_FLASH_REQUIRED_MASK,
            BOARD_SPIB_FLASH_FAIL_NONE,
            BOARD_SPIB_FLASH_MANUFACTURER_ID,
            BOARD_SPIB_FLASH_MEMORY_TYPE,
            BOARD_SPIB_FLASH_CAPACITY_64_MBIT,
            record);
    }

    if(testId == BOARD_TEST_ID_SPIB_FRAM_EXTERNAL)
    {
        return BoardSpi_EvaluateSpibFramStatus(
            BOARD_SPIB_FRAM_REQUIRED_MASK,
            BOARD_SPIB_FRAM_FAIL_NONE,
            0x00U,
            BOARD_SPIB_FRAM_MANUFACTURER_ID,
            BOARD_SPIB_FRAM_PRODUCT_ID_HIGH,
            BOARD_SPIB_FRAM_PRODUCT_ID_LOW,
            record);
    }

    if(testId == BOARD_TEST_ID_SYS_CLOCK)
    {
        return BoardSystem_EvaluateMask(BOARD_SYSTEM_CLOCK_EXPECTED_MASK,
                                        BOARD_SYSTEM_CLOCK_EXPECTED_MASK,
                                        BOARD_TEST_ERROR_SYS_CLOCK,
                                        record);
    }

    if(testId == BOARD_TEST_ID_SYS_TIMER)
    {
        return BoardSystem_EvaluateTimerDelta(5000UL, 1000UL, record);
    }

    if(testId == BOARD_TEST_ID_SYS_WATCHDOG)
    {
        return BoardSystem_EvaluateMask(BOARD_SYSTEM_WATCHDOG_DISABLED,
                                        BOARD_SYSTEM_WATCHDOG_DISABLED,
                                        BOARD_TEST_ERROR_WATCHDOG_CFG,
                                        record);
    }

    if(testId == BOARD_TEST_ID_RAM)
    {
        record->measuredValue = (float)BOARD_SYSTEM_RAM_WORD_COUNT;
        return BOARD_TEST_RESULT_PASS;
    }

    if(testId == BOARD_TEST_ID_FLASH)
    {
        return BoardSystem_EvaluateMask(BOARD_SYSTEM_FLASH_EXPECTED_MASK,
                                        BOARD_SYSTEM_FLASH_EXPECTED_MASK,
                                        BOARD_TEST_ERROR_FLASH_CFG,
                                        record);
    }

    if(testId == BOARD_TEST_ID_GPIO)
    {
        return BoardGpio_EvaluateProgramLedReadback(
            BOARD_GPIO_LED_READBACK_MASK, record);
    }

    record->errorCode = BOARD_TEST_ERROR_UNSUPPORTED;
    return BOARD_TEST_RESULT_NOT_SUPPORTED;
}

static void TestInitIsSafe(void)
{
    const BoardTest_Descriptor *descriptor;

    BoardTest_Init();
    assert(gBoardTestManager.mode == BOARD_TEST_MODE_IDLE);
    assert(gBoardTestManager.activeTestId == BOARD_TEST_INVALID_ID);
    assert(gBoardTestManager.activeStage == BOARD_TEST_STAGE_BOARD_ONLY);
    assert(gBoardTestManager.hpdInputSource ==
           BOARD_TEST_HPD_INPUT_SOFTWARE_PHYSICAL);
    assert(gBoardTestManager.pwmAllowed == 0U);
    assert(gBoardTestManager.driverAllowed == 0U);
    assert(BoardTest_GetCount() == BOARD_TEST_ITEM_COUNT);
    descriptor = BoardTest_GetDescriptor(BOARD_TEST_ITEM_COUNT - 1U);
    assert(descriptor != 0);
    assert(descriptor->id == BOARD_TEST_ID_LV_RESOLVER_EXTERNAL);
    assert(BoardTest_GetDescriptor(BOARD_TEST_ITEM_COUNT) == 0);
}

static void TestBoardProfiles(void)
{
    const BoardProfile_Descriptor *profile;
    const BoardProfile_HardwareDescriptor *hardware;
    const BoardTest_Record *record;

    BoardProfile_Init(BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(gBoardProfileRuntimeStatus.state ==
           BOARD_PROFILE_STATE_NETWORK_READY);
    assert(BoardProfile_GetCurrent() == 0);
    assert(BoardTest_StartSingle(BOARD_TEST_ID_I2C_RTC) ==
           BOARD_TEST_RESULT_SAFETY_LOCKED);
    record = BoardTest_GetRecord(BOARD_TEST_ID_I2C_RTC);
    assert(record->errorCode == BOARD_TEST_ERROR_PROFILE_NOT_CONFIRMED);

    assert(BoardProfile_Select(0x7FFFU) ==
           BOARD_TEST_RESULT_NOT_SUPPORTED);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER) ==
           BOARD_TEST_RESULT_NOT_SUPPORTED);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    profile = BoardProfile_GetCurrent();
    hardware = BoardProfile_GetCurrentHardware();
    assert(profile != 0);
    assert(hardware != 0);
    assert(profile->id == BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED);
    assert(hardware->boardId == BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED);
    assert(hardware->ethernetInterface == BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_ADC_BASIC) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_GPIO) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_ETHERNET) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_ETHERNET_SOCKET) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_ETHERNET_TCP_LINK) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_ETHERNET_TCP_ECHO) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_ETHERNET_TCP_STABILITY) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_CAN_HOST) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_CAN_EXTERNAL) != 0U);
    assert(hardware->pins.canBTransmit == 6U);
    assert(hardware->pins.canBReceive == 7U);
    assert(hardware->pins.canBTransmitMux == 6U);
    assert(hardware->pins.canBReceiveMux == 6U);
    assert(hardware->pins.rs422Transmit == 38U);
    assert(hardware->pins.rs422Receive == 39U);
    assert(hardware->pins.rs422TransmitMux == 5U);
    assert(hardware->pins.rs422ReceiveMux == 5U);
    assert((BoardProfile_GetEffectiveCapabilities() &
            BOARD_PROFILE_CAP_RS422) != 0UL);
    assert((BoardProfile_GetImplementedCapabilities() &
            BOARD_PROFILE_CAP_RS422) != 0UL);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_RS422_EXTERNAL) != 0U);
    assert(BoardProfile_IsCapabilityValidated(BOARD_PROFILE_CAP_RS422) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SCI_HOST) == 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIB_INTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIC_INTERNAL) == 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPI_EXTERNAL) == 0U);
    assert(BoardProfile_IsCapabilityValidated(BOARD_PROFILE_CAP_SPIB) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SPIB_FLASH_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SPIB_FRAM_EXTERNAL) != 0U);
    assert(BoardProfile_IsCapabilityValidated(
               BOARD_PROFILE_CAP_SPIB_FLASH) == 0U);
    assert(BoardProfile_IsCapabilityValidated(
               BOARD_PROFILE_CAP_SPIB_FRAM) != 0U);

    BoardProfile_Clear();
    assert(gBoardProfileRuntimeStatus.state ==
           BOARD_PROFILE_STATE_NETWORK_READY);
    BoardProfile_SetDetectedEthernet(BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_SYSTEM_MASTER) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    profile = BoardProfile_GetCurrent();
    hardware = BoardProfile_GetCurrentHardware();
    assert(profile != 0);
    assert(hardware != 0);
    assert(profile->id == BOARD_PROFILE_ID_SYSTEM_MASTER);
    assert(hardware->boardId == BOARD_PROFILE_ID_SYSTEM_MASTER);
    assert(hardware->hardwareRevision ==
           BOARD_PROFILE_HARDWARE_REVISION_SYSTEM_MASTER_V01);
    assert(BoardProfile_IsCapabilityValidated(BOARD_PROFILE_CAP_SCIB) != 0U);
    assert((BoardProfile_GetEffectiveCapabilities() &
            BOARD_PROFILE_CAP_EMIF_W5300) != 0UL);
    assert(hardware->pins.scibTransmit == BOARD_PIN_SCIB_TX);
    assert(BoardProfile_GetById(BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER) != 0);
    assert(BoardProfile_GetById(BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED) != 0);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIB_INTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPI_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SPIB_FLASH_EXTERNAL) == 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SPIB_FRAM_EXTERNAL) == 0U);
}

static void TestSingleI2cPasses(void)
{
    const BoardTest_Record *record;

    BoardTest_Init();
    assert(BoardTest_StartSingle(BOARD_TEST_ID_I2C_RTC) ==
           BOARD_TEST_RESULT_RUNNING);
    BoardTest_Process(TestExecutor);
    record = BoardTest_GetRecord(BOARD_TEST_ID_I2C_RTC);
    assert(record != 0);
    assert(record->result == BOARD_TEST_RESULT_PASS);
    assert(gBoardTestManager.mode == BOARD_TEST_MODE_IDLE);
}

static void TestSingleFpgaProbePasses(void)
{
    const BoardTest_Record *record;

    BoardTest_Init();
    assert(BoardTest_StartSingle(BOARD_TEST_ID_FPGA_EMIF2_BASIC) ==
           BOARD_TEST_RESULT_RUNNING);
    BoardTest_Process(TestExecutor);
    record = BoardTest_GetRecord(BOARD_TEST_ID_FPGA_EMIF2_BASIC);
    assert(record != 0);
    assert(record->result == BOARD_TEST_RESULT_PASS);
    assert(record->errorCode == BOARD_TEST_ERROR_NONE);
    assert(gBoardTestManager.mode == BOARD_TEST_MODE_IDLE);
}

static void TestSingleDidoUsesExternalStage(void)
{
    const BoardTest_Record *record;

    BoardTest_Init();
    assert(BoardTest_StartSingle(BOARD_TEST_ID_DIDO_FPGA_DO_EXTERNAL) ==
           BOARD_TEST_RESULT_NOT_SUPPORTED);
    assert(BoardTest_StartSingleInStage(
               BOARD_TEST_ID_DIDO_FPGA_DO_EXTERNAL,
               BOARD_TEST_STAGE_EXTERNAL_CONNECTED) ==
           BOARD_TEST_RESULT_RUNNING);
    BoardTest_Process(TestExecutor);
    record = BoardTest_GetRecord(BOARD_TEST_ID_DIDO_FPGA_DO_EXTERNAL);
    assert(record != 0);
    assert(record->result == BOARD_TEST_RESULT_WARN);
    assert(record->errorCode == BOARD_TEST_ERROR_NONE);
    assert(gBoardTestManager.mode == BOARD_TEST_MODE_IDLE);
}

static void TestSinglePwmDidoUsesExternalStage(void)
{
    const BoardTest_Record *record;

    BoardProfile_Clear();
    BoardProfile_SetDetectedEthernet(BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    BoardTest_Init();
    assert(BoardTest_StartSingle(BOARD_TEST_ID_PWM_DIDO_EXTERNAL) ==
           BOARD_TEST_RESULT_NOT_SUPPORTED);
    assert(BoardTest_StartSingleInStage(
               BOARD_TEST_ID_PWM_DIDO_EXTERNAL,
               BOARD_TEST_STAGE_EXTERNAL_CONNECTED) ==
           BOARD_TEST_RESULT_RUNNING);
    BoardTest_Process(TestExecutor);
    record = BoardTest_GetRecord(BOARD_TEST_ID_PWM_DIDO_EXTERNAL);
    assert(record != 0);
    assert(record->result == BOARD_TEST_RESULT_WARN);
    assert(record->errorCode == BOARD_TEST_ERROR_NONE);
    assert(gBoardTestManager.mode == BOARD_TEST_MODE_IDLE);

    BoardProfile_Clear();
    BoardProfile_SetDetectedEthernet(BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_SYSTEM_MASTER) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
}

static void TestSingleDriverFaultDiUsesExternalStage(void)
{
    const BoardTest_Record *record;

    BoardProfile_Clear();
    BoardProfile_SetDetectedEthernet(BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    BoardTest_Init();
    assert(BoardTest_StartSingle(BOARD_TEST_ID_DRIVER_FAULT_DI_EXTERNAL) ==
           BOARD_TEST_RESULT_NOT_SUPPORTED);
    assert(BoardTest_StartSingleInStage(
               BOARD_TEST_ID_DRIVER_FAULT_DI_EXTERNAL,
               BOARD_TEST_STAGE_EXTERNAL_CONNECTED) ==
           BOARD_TEST_RESULT_RUNNING);
    BoardTest_Process(TestExecutor);
    record = BoardTest_GetRecord(BOARD_TEST_ID_DRIVER_FAULT_DI_EXTERNAL);
    assert(record != 0);
    assert(record->result == BOARD_TEST_RESULT_PASS);
    assert(record->errorCode == BOARD_TEST_ERROR_NONE);
    assert(gBoardTestManager.mode == BOARD_TEST_MODE_IDLE);

    BoardProfile_Clear();
    BoardProfile_SetDetectedEthernet(BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_SYSTEM_MASTER) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
}

