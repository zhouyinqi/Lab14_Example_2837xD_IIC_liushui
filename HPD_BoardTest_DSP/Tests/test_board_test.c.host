static void TestProgramLedEvaluation(void)
{
    BoardTest_Record record;

    record.errorCode = BOARD_TEST_ERROR_NONE;
    assert(BoardGpio_EvaluateProgramLedReadback(
               BOARD_GPIO_LED_READBACK_MASK, &record) ==
           BOARD_TEST_RESULT_PASS);
    assert(record.rawValue == BOARD_GPIO_LED_READBACK_MASK);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);

    assert(BoardGpio_EvaluateProgramLedReadback(0x003EU, &record) ==
           BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_GPIO_READBACK);
}

static void TestSystemMaskEvaluation(void)
{
    BoardTest_Record record;

    assert(BoardSystem_EvaluateMask(BOARD_SYSTEM_CLOCK_EXPECTED_MASK,
                                    BOARD_SYSTEM_CLOCK_EXPECTED_MASK,
                                    BOARD_TEST_ERROR_SYS_CLOCK,
                                    &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);

    assert(BoardSystem_EvaluateMask(0UL,
                                    BOARD_SYSTEM_CLOCK_EXPECTED_MASK,
                                    BOARD_TEST_ERROR_SYS_CLOCK,
                                    &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_SYS_CLOCK);
}

static void TestSystemTimerEvaluation(void)
{
    BoardTest_Record record;

    assert(BoardSystem_EvaluateTimerDelta(5000UL, 1000UL, &record) ==
           BOARD_TEST_RESULT_PASS);
    assert(record.rawValue == 4000UL);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);

    assert(BoardSystem_EvaluateTimerDelta(900UL, 1000UL, &record) ==
           BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_SYS_TIMER);
}

static void TestCoreConfigurationMasks(void)
{
    BoardTest_Record record;
    BoardTest_U32 bit;
    for(bit = 1UL; bit <= BOARD_SYSTEM_STARTUP_WD_DISABLED; bit <<= 1U)
    {
        assert(BoardSystem_EvaluateMask(BOARD_SYSTEM_STARTUP_EXPECTED_MASK & ~bit,
            BOARD_SYSTEM_STARTUP_EXPECTED_MASK, BOARD_TEST_ERROR_STARTUP_CFG,
            &record) == BOARD_TEST_RESULT_FAIL);
    }
    assert(BoardSystem_EvaluateMask(BOARD_SYSTEM_STARTUP_EXPECTED_MASK,
        BOARD_SYSTEM_STARTUP_EXPECTED_MASK, BOARD_TEST_ERROR_STARTUP_CFG,
        &record) == BOARD_TEST_RESULT_PASS);
    for(bit = 1UL; bit <= BOARD_SYSTEM_INTERRUPT_XINT_VECTOR; bit <<= 1U)
    {
        assert(BoardSystem_EvaluateMask(BOARD_SYSTEM_INTERRUPT_EXPECTED_MASK & ~bit,
            BOARD_SYSTEM_INTERRUPT_EXPECTED_MASK, BOARD_TEST_ERROR_INTERRUPT_CFG,
            &record) == BOARD_TEST_RESULT_FAIL);
    }
    assert(BoardSystem_EvaluateMask(BOARD_SYSTEM_INTERRUPT_EXPECTED_MASK,
        BOARD_SYSTEM_INTERRUPT_EXPECTED_MASK, BOARD_TEST_ERROR_INTERRUPT_CFG,
        &record) == BOARD_TEST_RESULT_PASS);
}
static void TestW5300BusIsolation(void)
{
    BoardTest_U16 i, j, pin;
    BoardTest_Record record;
    const BoardProfile_HardwareDescriptor *hardware;
    const BoardProfile_LowVoltagePinMap *lv;
    hardware = BoardProfile_GetHardwareDescriptor(BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER,
        BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V04, BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(hardware != 0);
    lv = hardware->lowVoltagePins;
    for(i = 0U; i < BOARD_EMIF_W5300_PIN_COUNT; i++)
    {
        pin = BoardEmif_GetW5300Pin(i);
        assert(pin != BOARD_PROFILE_PIN_UNUSED);
        for(j = i + 1U; j < BOARD_EMIF_W5300_PIN_COUNT; j++)
            assert(pin != BoardEmif_GetW5300Pin(j));
        for(j = 0U; j < BOARD_PROFILE_LOW_VOLTAGE_DI_COUNT; j++)
            assert(pin != lv->digitalInputs[j]);
        for(j = 0U; j < BOARD_PROFILE_LOW_VOLTAGE_STO_COUNT; j++)
            assert(pin != lv->stoInputs[j]);
        for(j = 0U; j < BOARD_PROFILE_LOW_VOLTAGE_RESOLVER_SPI_COUNT; j++)
            assert(pin != lv->resolverSpi[j]);
        assert(pin != lv->fanOutput);
        assert(pin != lv->softStartOutput);
        assert(pin != lv->pwmSoftwareLock);
        assert(pin != lv->protectionBreakInput);
        assert(pin != lv->faultClearOutput);
        assert(pin != lv->rtcSda && pin != lv->rtcScl);
    }
    assert(BoardEmif_GetW5300Pin(BOARD_EMIF_W5300_PIN_COUNT) == BOARD_PROFILE_PIN_UNUSED);
    assert(BoardEmif_EvaluateBasicStatusForBus(BOARD_EMIF1_BASIC_REQUIRED_MASK,
        BOARD_EMIF_ASYNC_REQUIRED_MASK, 0U, 0U, &record) == BOARD_TEST_RESULT_PASS);
    assert(BoardEmif_EvaluateBasicStatusForBus(BOARD_EMIF1_BASIC_REQUIRED_MASK,
        BOARD_EMIF_ASYNC_REQUIRED_MASK, 0U, 1U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardEmif_EvaluateBasicStatusForBus(BOARD_EMIF1_BASIC_REQUIRED_MASK,
        0U, 0U, 0U, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardEmif_EvaluateBasicStatusForBus(BOARD_EMIF1_BASIC_REQUIRED_MASK &
        ~BOARD_EMIF_BASIC_EMIF1_CPU1, BOARD_EMIF_ASYNC_REQUIRED_MASK, 0U, 0U,
        &record) == BOARD_TEST_RESULT_FAIL);
}
static void TestSciaBoardRoutes(void)
{
    BoardSci_ScibPinConfiguration pins;
    BoardProfile_HardwareDescriptor copy;
    const BoardProfile_HardwareDescriptor *hardware;
    hardware = BoardProfile_GetHardwareDescriptor(BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER,
        BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V04, BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardSci_ResolveSciaPinConfiguration(hardware, &pins) == 1U);
    assert(pins.directionGpio == 30U && pins.txGpio == 8U && pins.rxGpio == 9U);
    assert(pins.txMux == 6U && pins.rxMux == 6U);
    copy = *hardware;
    copy.pins.sciaTransmit = 135U;
    assert(BoardSci_ResolveSciaPinConfiguration(&copy, &pins) == 0U);
    assert(pins.directionGpio == BOARD_PROFILE_PIN_UNUSED);
    assert(BoardSci_ResolveSciaPinConfiguration(0, &pins) == 0U);
    assert(BoardSci_ResolveSciaPinConfiguration(hardware, 0) == 0U);
    hardware = BoardProfile_GetHardwareDescriptor(BOARD_PROFILE_ID_SYSTEM_MASTER,
        BOARD_PROFILE_HARDWARE_REVISION_SYSTEM_MASTER_V01, BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardSci_ResolveSciaPinConfiguration(hardware, &pins) == 1U);
    assert(pins.directionGpio == 133U && pins.txGpio == 135U && pins.rxGpio == 136U);
}
static void TestSystemTimerBoundaries(void)
{
    BoardTest_Record record;
    assert(BoardSystem_EvaluateTimerDelta(0UL, 0UL, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardSystem_EvaluateTimerDelta(2000UL, 0xFFFFF830UL, &record) == BOARD_TEST_RESULT_PASS);
    assert(record.rawValue == 4000UL);
    assert(BoardSystem_EvaluateTimerDelta(2999UL, 0UL, &record) == BOARD_TEST_RESULT_FAIL);
    assert(BoardSystem_EvaluateTimerDelta(3000UL, 0UL, &record) == BOARD_TEST_RESULT_PASS);
    assert(BoardSystem_EvaluateTimerDelta(20000UL, 0UL, &record) == BOARD_TEST_RESULT_PASS);
    assert(BoardSystem_EvaluateTimerDelta(20001UL, 0UL, &record) == BOARD_TEST_RESULT_FAIL);
}
static void TestTmp116Evaluation(void)
