    assert(BoardCan_EvaluateExternalStatus(
               (BoardTest_U16)(BOARD_CAN_EXTERNAL_EXPECTED_MASK &
                               ~BOARD_CAN_EXTERNAL_RX_PATTERN_MATCH),
               BOARD_CAN_EXTERNAL_REQUEST_ID,
               BOARD_CAN_EXTERNAL_DATA_BYTES,
               0UL,
               BOARD_CAN_EXTERNAL_RESPONSE_ID,
               BOARD_CAN_EXTERNAL_REQUEST_PATTERN,
               0U,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_CAN_EXTERNAL);
    assert(record.expectedMin == (float)BOARD_CAN_EXTERNAL_REQUIRED_MASK);
    assert(record.expectedMax == (float)BOARD_CAN_EXTERNAL_DIAGNOSTIC_MASK);
}

static void TestCanDynamicPinConfiguration(void)
{
    const BoardProfile_HardwareDescriptor *hardware;
    BoardCan_PinConfiguration configuration;

    hardware = BoardProfile_GetHardwareDescriptor(
        BOARD_PROFILE_ID_SYSTEM_MASTER,
        BOARD_PROFILE_HARDWARE_REVISION_SYSTEM_MASTER_V01,
        BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardCan_ResolvePinConfiguration(hardware, &configuration) != 0U);
    assert(configuration.txGpio == 12U);
    assert(configuration.rxGpio == 13U);
    assert(configuration.txMux == 2U);
    assert(configuration.rxMux == 2U);

    hardware = BoardProfile_GetHardwareDescriptor(
        BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER,
        BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V04,
        BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardCan_ResolvePinConfiguration(hardware, &configuration) != 0U);
    assert(configuration.txGpio == 6U);
    assert(configuration.rxGpio == 7U);
    assert(configuration.txMux == 6U);
    assert(configuration.rxMux == 6U);

    hardware = BoardProfile_GetHardwareDescriptor(
        BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER,
        BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V04,
        BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardCan_ResolvePinConfiguration(hardware, &configuration) == 0U);

    hardware = BoardProfile_GetHardwareDescriptor(
        BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
        BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01,
        BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardCan_ResolvePinConfiguration(hardware, &configuration) != 0U);
    assert(configuration.txGpio == 6U);
    assert(configuration.rxGpio == 7U);
    assert(configuration.txMux == 6U);
    assert(configuration.rxMux == 6U);
    assert(BoardCan_ResolvePinConfiguration(0, &configuration) == 0U);
    assert(BoardCan_ResolvePinConfiguration(hardware, 0) == 0U);
}

static void TestScibDynamicPinConfiguration(void)
{
    const BoardProfile_HardwareDescriptor *hardware;
    BoardSci_ScibPinConfiguration configuration;

    hardware = BoardProfile_GetHardwareDescriptor(
        BOARD_PROFILE_ID_SYSTEM_MASTER,
