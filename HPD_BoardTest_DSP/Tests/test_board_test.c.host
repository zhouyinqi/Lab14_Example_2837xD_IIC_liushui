static void TestDiFpgaEvaluation(void)
{
    BoardTest_Record record;

    assert(BOARD_DI_FPGA_INPUT_ADDR == 0x00002000UL);
    assert(BOARD_DI_EDI1_BIT == 0x0001U);
    assert(BOARD_DI_EDI6_BIT == 0x0020U);
    assert(BOARD_DI_HDI1_BIT == 0x0040U);
    assert(BOARD_DI_HDI2_BIT == 0x0080U);

    assert(BoardDi_EvaluateFpgaStatus(
               BOARD_DI_REQUIRED_STATUS_MASK,
               BOARD_DI_FAIL_NONE,
               BOARD_DI_DEFAULT_CHANNEL_MASK,
               BOARD_DI_INPUT_MASK,
               BOARD_DI_INPUT_MASK,
               BOARD_DI_INPUT_MASK,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.rawValue == 0x00FF00FFUL);
    assert(record.measuredValue == 255.0F);

    assert(BoardDi_EvaluateFpgaStatus(
               BOARD_DI_REQUIRED_STATUS_MASK,
               BOARD_DI_FAIL_NONE,
               BOARD_DI_EDI1_BIT | BOARD_DI_HDI2_BIT,
               BOARD_DI_EDI1_BIT | BOARD_DI_HDI2_BIT,
               BOARD_DI_EDI1_BIT | BOARD_DI_HDI2_BIT,
               BOARD_DI_EDI1_BIT | BOARD_DI_HDI2_BIT,
               &record) == BOARD_TEST_RESULT_PASS);
    assert(record.errorCode == BOARD_TEST_ERROR_NONE);
    assert(record.expectedMin == 129.0F);

    assert(BoardDi_EvaluateFpgaStatus(
               BOARD_DI_STATUS_CONFIGURED |
               BOARD_DI_STATUS_MAGIC_VALID |
               BOARD_DI_STATUS_INACTIVE_SEEN,
               BOARD_DI_FAIL_TIMEOUT,
               BOARD_DI_DEFAULT_CHANNEL_MASK,
               BOARD_DI_INPUT_MASK,
               0U,
               0U,
               &record) == BOARD_TEST_RESULT_TIMEOUT);
    assert(record.errorCode == BOARD_TEST_ERROR_DI_EXTERNAL);

    assert(BoardDi_EvaluateFpgaStatus(
               BOARD_DI_STATUS_CONFIGURED,
               BOARD_DI_FAIL_MAGIC,
               BOARD_DI_DEFAULT_CHANNEL_MASK,
               0U,
               0U,
               0U,
               &record) == BOARD_TEST_RESULT_FAIL);
    assert(record.errorCode == BOARD_TEST_ERROR_DI_EXTERNAL);
}

