    assert(BoardProfile_GetTestAvailability(
               BOARD_TEST_ID_ADC_PT100_MUX_EXTERNAL,
               BOARD_TEST_CAP_IMPLEMENTED |
               BOARD_TEST_CAP_EXTERNAL_INJECT |
               BOARD_TEST_CAP_TEST_BENCH) ==
           BOARD_PROFILE_TEST_PENDING_VALIDATION);
    assert(BoardProfile_GetTestAvailability(
               BOARD_TEST_ID_SPIB_FLASH_EXTERNAL,
               BOARD_TEST_CAP_IMPLEMENTED | BOARD_TEST_CAP_TEST_BENCH) ==
           BOARD_PROFILE_TEST_PENDING_VALIDATION);
    assert(BoardProfile_GetTestAvailability(
               BOARD_TEST_ID_I2C_EXTERNAL,
               BOARD_TEST_CAP_TEST_BENCH) ==
           BOARD_PROFILE_TEST_NOT_AVAILABLE);
    assert(BoardProfile_GetTestAvailability(
               BOARD_TEST_ID_SYS_INTERRUPT,
               0U) == BOARD_PROFILE_TEST_PENDING_DEVELOPMENT);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_ETHERNET) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_ETHERNET_SOCKET) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_ETHERNET_TCP_LINK) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_ETHERNET_TCP_ECHO) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_ETHERNET_TCP_STABILITY) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_CAN_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SCI_HOST) == 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SCI_RS485_EXTERNAL) == 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_RS422_EXTERNAL) != 0U);
    assert(BoardProfile_IsCapabilityValidated(BOARD_PROFILE_CAP_RS422) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SCIA_HANDHELD_EXTERNAL) == 0U);
    assert((BoardProfile_GetEffectiveCapabilities() &
            BOARD_PROFILE_CAP_SPIB) != 0UL);
    assert((BoardProfile_GetImplementedCapabilities() &
            BOARD_PROFILE_CAP_SPIB) != 0UL);
    assert((BoardProfile_GetImplementedCapabilities() &
            BOARD_PROFILE_CAP_SPIB_FLASH_FRAM) == 0UL);
    assert((BoardProfile_GetImplementedCapabilities() &
            BOARD_PROFILE_CAP_SPIB_FLASH) != 0UL);
    assert((BoardProfile_GetImplementedCapabilities() &
            BOARD_PROFILE_CAP_SPIB_FRAM) != 0UL);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIB_INTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SPIB_FLASH_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SPIB_FRAM_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIC_INTERNAL) == 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPI_EXTERNAL) == 0U);
    assert(BoardProfile_GetTestAvailability(
               BOARD_TEST_ID_LV_DI_EXTERNAL, 0U) ==
           BOARD_PROFILE_TEST_NOT_AVAILABLE);
    assert(BoardProfile_IsCapabilityValidated(BOARD_PROFILE_CAP_SPIB) != 0U);
    assert(BoardProfile_IsCapabilityValidated(
               BOARD_PROFILE_CAP_SPIB_FLASH) == 0U);
    assert(BoardProfile_IsCapabilityValidated(
               BOARD_PROFILE_CAP_SPIB_FRAM) != 0U);
    assert(hardware->pins.spibSimo == 63U);
    assert(hardware->pins.spibSomi == 64U);
    assert(hardware->pins.spibClock == 65U);
    assert(hardware->pins.spibFlashChipSelect == 66U);
    assert(hardware->pins.spibFramChipSelect == 62U);
    assert(hardware->pins.spibMux == 15U);
    assert((hardware->validatedCapabilities &
            ~hardware->implementedCapabilities) == 0UL);
}

static void TestUnknownHardwarePairsAreRejected(void)
{
    AssertUnsupportedPair(BOARD_PROFILE_ETHERNET_EMIF_W5300,
                          BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED);
    AssertUnsupportedPair(BOARD_PROFILE_ETHERNET_SPIC_W5500,
                          BOARD_PROFILE_ID_SYSTEM_MASTER);
    AssertUnsupportedPair(BOARD_PROFILE_ETHERNET_SPIC_W5500,
                          BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER);

    assert(BoardProfile_GetHardwareDescriptor(
               BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
               BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01,
               BOARD_PROFILE_ETHERNET_EMIF_W5300) == 0);
    assert(BoardProfile_GetHardwareDescriptor(
               BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER,
               BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V04,
               BOARD_PROFILE_ETHERNET_SPIC_W5500) == 0);
}

int main(void)
{
    TestKnownHardwareMatrix();
    TestUnknownHardwarePairsAreRejected();
    puts("board_profile: known hardware matrix test passed");
    return 0;
}
