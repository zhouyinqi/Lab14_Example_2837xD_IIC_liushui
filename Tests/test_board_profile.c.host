#include <assert.h>
#include <stdio.h>

#include "Board_Profile.h"

static void AssertUnsupportedPair(BoardTest_U16 ethernetInterface,
                                  BoardTest_U16 boardId)
{
    BoardProfile_Init(ethernetInterface);
    assert(BoardProfile_Select(boardId) == BOARD_TEST_RESULT_NOT_SUPPORTED);
    assert(gBoardProfileRuntimeStatus.selectedId == BOARD_PROFILE_ID_NONE);
    assert(BoardProfile_GetCurrentHardware() == 0);
}

static void TestKnownHardwareMatrix(void)
{
    const BoardProfile_HardwareDescriptor *hardware;

    BoardProfile_Init(BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_SYSTEM_MASTER) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    hardware = BoardProfile_GetCurrentHardware();
    assert(hardware != 0);
    assert(hardware->boardId == BOARD_PROFILE_ID_SYSTEM_MASTER);
    assert(hardware->ethernetInterface == BOARD_PROFILE_ETHERNET_EMIF_W5300);
    assert(hardware->pins.canBTransmit == 12U);
    assert(hardware->pins.canBReceive == 13U);
    assert(hardware->pins.scibDirection == 11U);
    assert(hardware->pins.scibTransmit == 14U);
    assert(hardware->pins.scibReceive == 15U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIB_INTERNAL) != 0U);

    BoardProfile_Clear();
    assert(BoardProfile_Select(BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    hardware = BoardProfile_GetCurrentHardware();
    assert(hardware != 0);
    assert(hardware->hardwareRevision ==
           BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V03);
    assert(hardware->pinMapRevision == 3U);
    assert(hardware->pins.ethernetInterrupt == 0U);
    assert(hardware->pins.ethernetReset == 1U);
    assert(hardware->pins.canBTransmit == 6U);
    assert(hardware->pins.canBReceive == 7U);
    assert(hardware->pins.canBTransmitMux == 6U);
    assert(hardware->pins.canBReceiveMux == 6U);
    assert(hardware->pins.scibDirection == 32U);
    assert(hardware->pins.scibTransmit == 10U);
    assert(hardware->pins.scibReceive == 11U);
    assert(hardware->pins.scibTransmitMux == 6U);
    assert(hardware->pins.scibReceiveMux == 6U);
    assert(hardware->pins.led1 == 89U);
    assert(hardware->pins.led2 == 88U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_GPIO) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_CAN_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SCI_RS485_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIB_INTERNAL) == 0U);

    BoardProfile_Init(BOARD_PROFILE_ETHERNET_SPIC_W5500);
    assert(BoardProfile_Select(BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED) ==
           BOARD_TEST_RESULT_PASS);
    assert(BoardProfile_Confirm() == BOARD_TEST_RESULT_PASS);
    hardware = BoardProfile_GetCurrentHardware();
    assert(hardware != 0);
    assert(hardware->hardwareRevision ==
           BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01);
    assert(hardware->pinMapRevision == 1U);
    assert(hardware->pins.ethernetInterrupt == 73U);
    assert(hardware->pins.ethernetReset == 68U);
    assert(hardware->pins.ethernetSimo == 69U);
    assert(hardware->pins.ethernetSomi == 70U);
    assert(hardware->pins.ethernetClock == 71U);
    assert(hardware->pins.ethernetChipSelect == 72U);
    assert(hardware->pins.canBTransmit == 6U);
    assert(hardware->pins.canBReceive == 7U);
    assert(hardware->pins.led1 == 47U);
    assert(hardware->pins.led2 == 46U);
    assert(hardware->pins.rs422Transmit == 38U);
    assert(hardware->pins.rs422Receive == 39U);
    assert(hardware->pins.rs422TransmitMux == 5U);
    assert(hardware->pins.rs422ReceiveMux == 5U);
    assert(hardware->pins.sciaTransmit == BOARD_PROFILE_PIN_UNUSED);
    assert(hardware->pins.scibTransmit == BOARD_PROFILE_PIN_UNUSED);
    assert((BoardProfile_GetEffectiveCapabilities() &
            BOARD_PROFILE_CAP_RS422) != 0UL);
    assert((BoardProfile_GetImplementedCapabilities() &
            BOARD_PROFILE_CAP_RS422) != 0UL);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_GPIO) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_ETHERNET) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_CAN_EXTERNAL) != 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SCI_HOST) == 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SCI_RS485_EXTERNAL) == 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_RS422_EXTERNAL) != 0U);
    assert(BoardProfile_IsCapabilityValidated(BOARD_PROFILE_CAP_RS422) != 0U);
    assert(BoardProfile_IsTestSupported(
               BOARD_TEST_ID_SCIA_HANDHELD_EXTERNAL) == 0U);
    assert(BoardProfile_IsTestSupported(BOARD_TEST_ID_SPIB_INTERNAL) == 0U);
    assert((hardware->validatedCapabilities &
            ~hardware->implementedCapabilities) == 0UL);
}

static void TestUnknownHardwarePairsAreRejected(void)
{
    AssertUnsupportedPair(BOARD_PROFILE_ETHERNET_EMIF_W5300,
                          BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED);
    AssertUnsupportedPair(BOARD_PROFILE_ETHERNET_SPIC_W5500,
                          BOARD_PROFILE_ID_SYSTEM_MASTER);
    AssertUnsupportedPair(BOARD_PROFILE_ETHERNET_SPIC_W5500,
                          BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER);

    assert(BoardProfile_GetHardwareDescriptor(
               BOARD_PROFILE_ID_LOW_ALTITUDE_UNIFIED,
               BOARD_PROFILE_HARDWARE_REVISION_LOW_ALTITUDE_V01,
               BOARD_PROFILE_ETHERNET_EMIF_W5300) == 0);
    assert(BoardProfile_GetHardwareDescriptor(
               BOARD_PROFILE_ID_LOW_VOLTAGE_INVERTER,
               BOARD_PROFILE_HARDWARE_REVISION_LOW_VOLTAGE_V03,
               BOARD_PROFILE_ETHERNET_SPIC_W5500) == 0);
}

int main(void)
{
    TestKnownHardwareMatrix();
    TestUnknownHardwarePairsAreRejected();
    puts("board_profile: known hardware matrix test passed");
    return 0;
}
